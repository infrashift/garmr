{
  "kind": "container",
  "metadata": {
    "name": "my-app",
    "namespace": "production"
  },
  "spec": {
    "image": "gcr.io/my-project/my-app:v1.2.3",
    "privileged": false,
    "runAsNonRoot": true,
    "runAsUser": 1000,
    "readOnlyRootFilesystem": true,
    "resources": {
      "limits": {
        "memory": "256Mi",
        "cpu": "500m"
      },
      "requests": {
        "memory": "128Mi",
        "cpu": "250m"
      }
    }
  }
}